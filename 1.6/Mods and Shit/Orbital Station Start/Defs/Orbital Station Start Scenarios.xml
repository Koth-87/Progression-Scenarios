<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FactionDef ParentName="PlayerFactionBase">
    <defName>Ferny_MedievalOrbitalSurvivors</defName>
    <label>New Starhold</label>
    <description>A small household stranded in a failing station above the rim.</description>
    <isPlayer>true</isPlayer>
    <categoryTag>Tribal</categoryTag>
    <pawnSingular>survivor</pawnSingular>
    <pawnsPlural>survivors</pawnsPlural>
    <basicMemberKind>Tribesperson</basicMemberKind>
    <techLevel>Medieval</techLevel>
    <factionNameMaker>NamerFactionTribal</factionNameMaker>
    <settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
    <allowedCultures>
      <li>Corunan</li>
    </allowedCultures>
    <backstoryFilters>
      <li>
        <categories>
          <li>Tribal</li>
        </categories>
      </li>
    </backstoryFilters>
    <factionIconPath>World/WorldObjects/Expanding/Village</factionIconPath>
    <settlementTexturePath>World/WorldObjects/TribalSettlement</settlementTexturePath>
    <forageabilityFactor>1.4</forageabilityFactor>
    <startingResearchTags>
      <li>TribalStart</li>
    </startingResearchTags>
    <startingTechprintsResearchTags>
      <li>TribalStart</li>
      <li>TribalStartTechprints</li>
    </startingTechprintsResearchTags>
    <apparelStuffFilter>
      <thingDefs>
        <li>Cloth</li>
      </thingDefs>
    </apparelStuffFilter>
    <recipePrerequisiteTags>
      <li>Tribal</li>
    </recipePrerequisiteTags>
  </FactionDef>

  <ScenarioDef ParentName="ScenarioBase" MayRequire="oskarpotocki.vfe.tribals">
    <defName>Ferny_AnimalOrbitalStation</defName>
    <label>Space Station</label>
    <modExtensions>
      <li Class="ProgressionScenarios.ScenarioExtension">
        <iconPath>ScenarioIcons/OrbitalTribe</iconPath>
        <displayOrder>99</displayOrder>
      </li>
    </modExtensions>
    <description>The three of you awake aboard an orbital station. You don't remember who you are or why you're here. The station is old and decaying, but its essential systems still function. Its halls are empty. Survival is now your only concern.</description>
    <scenario>
      <summary>Three wild men awaken with nothing aboard an orbital station.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>VFET_WildMen</factionDef>
      </playerFaction>
      <parts Inherit="False">
        <li Class="ScenPart_PlanetLayer">
          <def>PlanetLayerFixed</def>
          <tag>Orbit</tag>
          <layer>Orbit</layer>
          <settingsDef>Orbit</settingsDef>
          <hide>true</hide>
          <connections>
            <Surface>
              <zoomMode>ZoomIn</zoomMode>
            </Surface>
          </connections>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The three of you awake from cryptosleep aboard an orbital station. You don't remember who you are or why you're here. The station is old and decaying, but its essential systems still function. Its halls are empty. Survival is now your only concern.</text>
          <closeSound>VFET_GameStartSting_WildMen</closeSound>
        </li>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>3</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
        </li>
        <li Class="ScenPart_ForcedMap">
          <def>ForcedMap</def>
          <mapGenerator>OrbitalStationMap</mapGenerator>
          <layerDef>Orbit</layerDef>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>
        <li Class="ScenPart_ForcedHediff">
          <def>ForcedHediff</def>
          <visible>false</visible>
          <context>PlayerStarter</context>
          <chance>0.5</chance>
          <hideOffMap>true</hideOffMap>
          <hediff>CryptosleepSickness</hediff>
          <severityRange>1~1</severityRange>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

